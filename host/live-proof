#!/bin/sh
set -eu

: "${T3N_API_KEY:?T3N_API_KEY is required}"
[ "$(id -u)" = 0 ] || { echo "run through pnpm host:live-proof" >&2; exit 1; }
owner=${SUDO_USER:?SUDO_USER is required}
requested_origin=${TRUSTRUN_EXECUTOR_ORIGIN:?TRUSTRUN_EXECUTOR_ORIGIN is required}
node_bin=
for directory in $(printf %s "$PATH" | tr : ' '); do
  candidate=$directory/node
  if [ -x "$candidate" ] && sudo -n -u trustrun-executor "$candidate" --version >/dev/null 2>&1; then
    node_bin=$candidate
    break
  fi
done
[ -n "$node_bin" ] || { echo "no Node executable is available to trustrun-executor" >&2; exit 1; }
cert=/var/lib/trustrun-executor/executor.crt
key=/var/lib/trustrun-executor/executor.key
state=/var/lib/trustrun-executor/state.db
proof_state=/var/lib/trustrun-executor/live-proof.env
host_executor=/usr/local/lib/trustrun-executor/server.mjs
executor_unit=trustrun-proof-executor.service
cleanup() {
  systemctl stop "$executor_unit" 2>/dev/null || true
  rm -f "$proof_state"
}
trap cleanup EXIT INT TERM HUP

[ "$(stat -c '%U:%a' "$host_executor")" = root:644 ] || { echo "run pnpm host:install first" >&2; exit 1; }
origin=$("$node_bin" -e '
const value = process.argv[1];
try {
  const url = new URL(value);
  if (url.protocol !== "https:" || !url.hostname || url.username || url.password || url.pathname !== "/" || url.search || url.hash) throw new Error();
  process.stdout.write(url.origin);
} catch { process.exit(1); }
' "$requested_origin") || { echo "TRUSTRUN_EXECUTOR_ORIGIN must be a bare HTTPS origin" >&2; exit 1; }

if [ -f "$proof_state" ]; then
  [ "$(stat -c '%U:%a' "$proof_state")" = root:600 ] || { echo "invalid live proof state" >&2; exit 1; }
  . "$proof_state"
  [ "$TRUSTRUN_EXECUTOR_ORIGIN" = "$origin" ] || { systemctl stop trustrun-proof-tunnel.service "$executor_unit" 2>/dev/null || true; rm -f "$proof_state"; }
fi

if [ -f "$proof_state" ]; then
  [ "${#TRUSTRUN_EXECUTOR_BEARER}" -ge 32 ] || { echo "invalid live proof credential" >&2; exit 1; }
  systemctl is-active --quiet "$executor_unit" || { echo "live proof executor is no longer active; publish a higher contract version before creating a replacement" >&2; exit 1; }
  trap - EXIT INT TERM HUP
  exec sudo -n -u "$owner" env PATH="$PATH" T3N_API_KEY="$T3N_API_KEY" TRUSTRUN_EXECUTOR_ORIGIN="$TRUSTRUN_EXECUTOR_ORIGIN" TRUSTRUN_EXECUTOR_BEARER="$TRUSTRUN_EXECUTOR_BEARER" pnpm t3:live-proof
fi

if systemctl is-active --quiet "$executor_unit"; then
  echo "stale live proof units without state" >&2
  exit 1
fi

if [ ! -f "$cert" ] || [ ! -f "$key" ]; then
  sudo -n -u trustrun-executor openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=localhost -keyout "$key" -out "$cert" >/dev/null 2>&1
fi

bearer=$(openssl rand -base64 48)
systemd-run --quiet --collect --unit=trustrun-proof-executor --uid=trustrun-executor --gid=trustrun-executor \
  --setenv=TRUSTRUN_EXECUTOR_BEARER="$bearer" \
  --setenv=TRUSTRUN_EXECUTOR_TLS_CERT="$cert" \
  --setenv=TRUSTRUN_EXECUTOR_TLS_KEY="$key" \
  --setenv=TRUSTRUN_EXECUTOR_STATE="$state" \
  "$node_bin" "$host_executor"

code=
i=0
while [ "$i" -lt 5 ]; do
  code=$(curl --max-time 1 --silent --insecure --output /dev/null --write-out '%{http_code}' --request POST https://127.0.0.1:8443/v1/service/status || true)
  [ "$code" = 401 ] && break
  i=$((i + 1))
  sleep 1
done
[ "$code" = 401 ] || { journalctl --no-pager -u "$executor_unit" -n 20 >&2; exit 1; }

code=$(curl --max-time 5 --silent --output /dev/null --write-out '%{http_code}' --request POST "$origin/v1/service/status" || true)
[ "$code" = 401 ] || { echo "stable executor origin did not return 401" >&2; exit 1; }

sudo -n -u "$owner" env \
  PATH="$PATH" \
  T3N_API_KEY="$T3N_API_KEY" \
  TRUSTRUN_EXECUTOR_ORIGIN="$origin" \
  TRUSTRUN_EXECUTOR_BEARER="$bearer" \
  pnpm t3:publish
umask 077
printf 'TRUSTRUN_EXECUTOR_ORIGIN=%s\nTRUSTRUN_EXECUTOR_BEARER=%s\n' "$origin" "$bearer" >"$proof_state"
trap - EXIT INT TERM HUP
exec sudo -n -u "$owner" env \
  PATH="$PATH" \
  T3N_API_KEY="$T3N_API_KEY" \
  TRUSTRUN_EXECUTOR_ORIGIN="$origin" \
  TRUSTRUN_EXECUTOR_BEARER="$bearer" \
  pnpm t3:live-proof
