#!/bin/sh
set -eu

[ "$(id -u)" = 0 ] || { echo "run through pnpm sandbox" >&2; exit 1; }
owner=$(cat /etc/trustrun/sandbox-owner)
case "$owner" in ""|*[!A-Za-z0-9_-]*) echo "invalid sandbox owner" >&2; exit 1;; esac
[ "${SUDO_USER:-}" = "$owner" ] || { echo "sandbox owner mismatch" >&2; exit 1; }
socket=${TRUSTRUN_SESSION_SOCKET:?TRUSTRUN_SESSION_SOCKET is required}
node_bin=${TRUSTRUN_NODE_BIN:?TRUSTRUN_NODE_BIN is required}
workspace=$(pwd -P)
[ -S "$socket" ] && [ "$(stat -c %U "$socket")" = "$owner" ] || { echo "invalid session socket" >&2; exit 1; }
[ -f "$node_bin" ] && [ -x "$node_bin" ] || { echo "invalid Node executable" >&2; exit 1; }
[ "$(stat -c %U "$workspace")" = "$owner" ] || { echo "workspace must be owned by the sandbox owner" >&2; exit 1; }

mode=sandbox
if [ "${1:-}" = "--codex-demo" ]; then
  [ "$#" = 1 ] || { echo "Codex demo accepts no arguments" >&2; exit 2; }
  mode=codex-demo
  codex_bin=/usr/local/lib/trustrun-runtime/codex
  [ -f "$codex_bin" ] && [ -x "$codex_bin" ] && [ "$(stat -c %U "$codex_bin")" = root ] && [ "$(stat -c %a "$codex_bin")" = 755 ] || { echo "run pnpm host:install to install the trusted Codex CLI" >&2; exit 1; }
  model_socket="$(dirname "$socket")/model.sock"
  [ -r /etc/trustrun/openai.env ] || { echo "TrustRun OpenAI gateway is not configured" >&2; exit 1; }
fi

unit="trustrun-sandbox-$$"
cleanup() {
  /usr/bin/systemctl stop "$unit" >/dev/null 2>&1 || true
  [ -z "${gateway:-}" ] || kill "$gateway" >/dev/null 2>&1 || true
}
trap 'cleanup; exit 130' INT TERM HUP
trap cleanup EXIT

if [ "$mode" = codex-demo ]; then
  set -a
  . /etc/trustrun/openai.env
  set +a
  umask 077
  /usr/sbin/runuser -u "$owner" -- env -i PATH=/usr/bin:/bin OPENAI_API_KEY="$OPENAI_API_KEY" TRUSTRUN_MODEL_SOCKET="$model_socket" /usr/bin/node /usr/local/lib/trustrun-runtime/model-gateway.mjs &
  gateway=$!
  while [ ! -S "$model_socket" ]; do sleep 0.05; done
  [ "$(stat -c %U "$model_socket")" = "$owner" ] || { echo "invalid model gateway socket" >&2; exit 1; }
  set -- -- /usr/local/lib/trustrun-runtime/sandbox-codex-demo
fi

if [ "$mode" = codex-demo ]; then
  if env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin TRUSTRUN_SESSION_SOCKET="$socket" TRUSTRUN_NODE_BIN="$node_bin" \
    /usr/bin/systemd-run --quiet --collect --wait --pipe --unit="$unit" \
    --uid="$owner" --gid="$(id -gn "$owner")" --working-directory="$workspace" \
    --setenv="TRUSTRUN_SESSION_SOCKET=$socket" --setenv="TRUSTRUN_NODE_BIN=$node_bin" --setenv="TRUSTRUN_CODEX_DEMO=1" --setenv="TRUSTRUN_MODEL_SOCKET=$model_socket" --setenv="TRUSTRUN_CODEX_BIN=$codex_bin" \
    --property=KillMode=control-group --property=NoNewPrivileges=yes \
    /usr/local/lib/trustrun-runtime/sandbox-run "$@"
  then status=0; else status=$?; fi
else
  if env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin TRUSTRUN_SESSION_SOCKET="$socket" TRUSTRUN_NODE_BIN="$node_bin" \
    /usr/bin/systemd-run --quiet --collect --wait --pipe --unit="$unit" \
    --uid="$owner" --gid="$(id -gn "$owner")" --working-directory="$workspace" \
    --setenv="TRUSTRUN_SESSION_SOCKET=$socket" --setenv="TRUSTRUN_NODE_BIN=$node_bin" \
    --property=KillMode=control-group --property=NoNewPrivileges=yes \
    /usr/local/lib/trustrun-runtime/sandbox-run "$@"
  then status=0; else status=$?; fi
fi
trap - EXIT INT TERM HUP
cleanup
exit "$status"
