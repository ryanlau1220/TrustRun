{
  "name": "trustrun",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "executor:test": "node executor/test.mjs",
    "contract:build": "cd contract && cargo build --target wasm32-wasip2 --release",
    "mcp": "node mcp/server.mjs",
    "host:install": "sudo host/install-root",
    "host:live-proof": "host/live-proof",
    "sandbox": "host/run-session --",
    "t3:publish": "node scripts/t3-publish.mjs",
    "t3:publish:test": "node scripts/t3-publish.test.mjs",
    "t3:preflight": "tsx scripts/t3-preflight.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@terminal3/t3n-sdk": "5.2.0"
  }
}
