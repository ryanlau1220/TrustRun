  "cards": [
    {
      "dot": "rose",
      "title": "Untrusted Sandbox",
      "items": [
        "Codex CLI runs with bwrap --clearenv and --unshare-all",
        "GONKA_API_KEY, T3N_API_KEY, and executor bearer are absent",
        "Direct network connection to executor port 8443 is blocked"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hardware Capability Boundary",
      "items": [
        "MCP exposes only service.status and service.restart",
        "Terminal 3 TEE verifies caller identity and injects bearer token",
        "TEE egress allowlist strictly confines traffic to executor endpoint"
      ]
    },
    {
      "dot": "cyan",
      "title": "Durable Rate Limiting & Target Isolation",
      "items": [
        "Executor enforces single-flight state and 10-minute cooldown in SQLite",
        "Parameterless root-owned helper restarts exclusively my-api.service",
        "Sanitized schemas return only { ok: true, status: ... }"
      ]
    }
  ]
