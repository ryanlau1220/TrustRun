package trustrun:contract@0.1.3;

world trustrun {
    import host:tenant/tenant-context@1.0.0;
    import host:interfaces/http@2.1.0;
    import host:interfaces/kv-store@2.1.0;

    export contracts;
}

interface contracts {
    record generic-input {
        input: option<list<u8>>,
        user-profile: option<list<u8>>,
        context: option<list<u8>>,
    }

    service-status: func(req: generic-input) -> result<list<u8>, string>;
    service-restart: func(req: generic-input) -> result<list<u8>, string>;
}
